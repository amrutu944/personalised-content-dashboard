# ───────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the keys you have.
# ALL keys are optional: without them the app uses built-in demo data.
# These are read ONLY on the server (Next.js API routes) and are never
# sent to the browser — do NOT prefix them with NEXT_PUBLIC_.
# ───────────────────────────────────────────────────────────────

# NewsAPI — free key at https://newsapi.org/register
NEWS_API_KEY=

# TMDB — free account at https://www.themoviedb.org/settings/api
# Use EITHER the v3 API key OR the v4 Read Access Token.
TMDB_API_KEY=
TMDB_READ_TOKEN=
